    "reference_theme": "Dark Orange Industrial",
    "reference_accent": "#FF9800",
    "reference_background": "#06111D",
    "reference_structure": ["compact_header", "quick_tiles", "left_collapsible_navigation", "recent_songs_strip", "two_by_two_main_cards", "compact_status_bar"],
