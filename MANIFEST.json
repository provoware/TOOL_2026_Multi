    "font_size_follows_zoom": true
  },
  "profile_database": {
    "module": "app/profile_store.py",
    "editor": "app/profile_editor.py",
    "storage": "daten/profile/db_profile.json",
    "categories": ["Genres", "Stimmungen", "Stil", "Stimme", "Besonderheiten"],
    "built_in_profiles": ["HardTechno", "HipHop/Rap", "Hörspiele"],
    "defaults_are_memory_only_until_change": true,
    "atomic_write": true,
