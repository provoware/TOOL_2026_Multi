    "dashboard_profile_selector": true,
    "remove_requires_confirmation": true
  },
  "todo": {
    "module": "app/todo_store.py",
    "window": "app/todo_window.py",
    "storage": "daten/todo/todo.json",
    "schema_version": 1,
    "fields": ["id", "title", "note_optional", "due_optional", "created_at", "completed_at"],
    "active_and_archive_same_transaction": true,
    "complete_rule": "Abhaken verschiebt den vollständigen Eintrag atomar aus active nach archive und setzt completed_at; es wird nichts gelöscht.",
    "due_format": "ISO-8601 lokale Datum/Zeit ohne Zeitzonen-Erfindung",
    "atomic_write": true,
    "archive_separate_view": true,
    "dashboard_location": "Planung -> Todo-Liste"
  },
  "calendar": {
    "module": "app/calendar_store.py",
    "window": "app/calendar_window.py",
    "reminder_controller": "app/calendar_reminders.py",
    "storage": "daten/kalender/termine.json",
    "schema_version": 1,
    "fields": ["id", "title", "note_optional", "start", "end", "reminder_minutes_optional", "created_at", "reminded_at"],
    "views": ["day", "week", "month", "year"],
    "range_rule": "Mehrtagestermine erscheinen in jeder Ansicht, deren Zeitbereich sie überlappen.",
    "reminder_options_minutes": [0, 5, 15, 30, 60, 1440],
    "reminder_none_supported": true,
    "reminder_check_interval_seconds": 30,
    "reminder_runtime": "while_dashboard_is_running",
    "background_service_when_dashboard_closed": false,
    "reminder_mark_rule": "Erst nach erfolgreichem Anzeigen wird reminded_at atomar gesetzt; während Anzeige schützt ein Reentrancy-Guard vor Doppelmeldung.",
    "time_semantics": "lokale Rechnerzeit für Start/Ende und Erinnerungsberechnung; keine erfundene Zeitzonenumrechnung",
    "atomic_write": true,
    "destructive_delete_in_iteration": false,
    "dashboard_location": "Planung -> Kalender"
  },
