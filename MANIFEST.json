{
  "schema_version": 10,
  "tool": {
    "name": "TOOL_2026_Multi",
    "repository": "provoware/TOOL_2026_Multi",
    "version": "0.10.0",
    "status": "AUSFUEHRBARER_KERN",
    "date": "2026-09-08"
  },
  "iteration": {
    "number": 11,
    "goal": "Gesamte produktive GUI auf PySide6 migrieren und Dashboardlayout, Hierarchie und Dark-Orange-Erscheinungsbild an den Provoware-Referenzentwurf angleichen; Recovery ausschließlich als einzelnen Navigationspunkt führen",
    "completed": 6,
    "open_next": 2
  },
  "runtime": {
    "entrypoint": "app/main.py",
    "launcher": "schnellstart.sh",
    "requirements": "requirements.txt",
    "headless_check": "python3 -m app.main --headless-check",
    "watcher": "scripts/process_watch.py",
    "diagnostic_package": "scripts/diagnosepaket.py"
  },
  "separation": {
    "source": "app/",
    "base_data": "daten/",
    "song_data": "daten/songtexte/",
    "song_versions": "daten/songtexte/.versionen/",
    "song_exports": "daten/songtexte/export/",
    "developer_quick_info": "Entwicklerinformation.txt",
    "texts": "texte/",
    "developer_docs": "docs/",
    "tests": "tests/",
    "runtime_logs": "logs/",
    "local_reports": "berichte/",
    "local_backups": "backups/"
  },
  "validation": {
    "command": "bash scripts/pruefen.sh --full",
    "runtime_command": "bash scripts/pruefen.sh --runtime",
    "headless_command": "python3 -m app.main --headless-check",
    "bounded": true,
    "qt_platform_for_ci": "offscreen",
    "targeted_tests": "python3 -m unittest tests.test_event_management tests.test_release_builder tests.test_security_watch tests.test_restore tests.test_diagnostics_logging tests.test_recovery_ui_logic tests.test_song_logic tests.test_song_library tests.test_song_library_controls; QT_QPA_PLATFORM=offscreen python3 -m unittest tests.test_recovery_ui_gui tests.test_song_gui tests.test_song_library_gui tests.test_song_library_controls_gui tests.test_dashboard_reference_gui",
    "write_failure_simulation": "python3 scripts/schreibfehler_simulieren.py"
  },
  "ci": {
    "workflow": ".github/workflows/qualitaet.yml",
    "checkout_action": "actions/checkout@v7.0.1",
    "gui_dependency": "PySide6==6.11.2",
    "gui_test_platform": "offscreen"
  },
  "ui": {
    "framework": "PySide6",
    "framework_version": "6.11.2",
    "tkinter_productive_gui_allowed": false,
    "dashboard_title": "Provoware-Datenbank-Dashboard 2026",
    "reference_theme": "Dark Orange Industrial",
    "reference_accent": "#FF9800",
    "reference_background": "#06111D",
    "reference_structure": ["compact_header", "quick_tiles", "left_collapsible_navigation", "recent_songs_strip", "two_by_two_main_cards", "compact_status_bar"],
    "main_cards": ["Workflow Übersicht", "DB-Eingaben", "Funktionen", "Systemanwendungen"],
    "sidebar_collapsed_width": 56,
    "sidebar_expanded_width": 214,
    "recovery_dashboard_occurrences": 1,
    "recovery_location": "single_left_navigation_item",
    "planned_navigation_visible_but_non_destructive": true
  },
  "song_editor": {
    "storage": "daten/songtexte/<Titel>.txt",
    "working_format": "parsebare UTF-8-Textdatei",
    "backward_compatible_from": "0.7.0",
    "autosave_seconds": 300,
    "save_on_focus_out": true,
    "save_on_close": true,
    "fields": ["title", "genre_optional", "mood_optional", "style_optional", "voice_optional", "special_optional", "tags_optional", "status", "favorite", "sections", "other_optional"],
    "statuses": ["Idee", "Entwurf", "Überarbeitung", "Fertig"],
    "section_types": ["Intro", "Strophe", "Pre-Chorus", "Refrain", "Hook", "Bridge", "Outro", "Spoken", "Instrumental"],
    "preview": true,
    "atomic_write": true,
    "version_rule": "Vor einem geänderten Überschreiben wird der vorherige Stand als unveränderter Schnappschuss gesichert; identische Saves erzeugen keine Version.",
    "exports": ["txt", "markdown", "json", "lyrics_only_txt"]
  },
  "song_library": {
    "module": "app/song_library.py",
    "open_existing": true,
    "recent_dashboard_limit": 5,
    "search_fields": ["title", "genre", "mood", "style", "voice", "tags"],
    "filters": ["genre", "mood", "style", "voice", "tags", "status", "favorites_only"],
    "sort_options": ["modified", "title", "genre", "tags", "status"],
    "group_options": ["none", "genre", "tags", "status"],
    "version_preview": "read_only_before_restore",
    "restore_rule": "Nur explizit gewählte Version; aktueller Stand wird unmittelbar davor als neuer Versionsstand gesichert; fremde Versionspfade werden abgewiesen.",
    "working_files_glob": "daten/songtexte/*.txt"
  },
  "dashboard_quick_info": {
    "target": "Entwicklerinformation.txt",
    "mode": "append_only",
    "timestamp": true,
    "confirm": ["button", "enter"]
  },
  "diagnostics": {
    "machine_log": "logs/ereignisse.jsonl",
    "human_reports": "berichte/",
    "regression_state": "logs/rueckfaelle.json",
    "regression_registry": "tests/regression_registry.json",
    "redaction": "app/redaction.py",
    "watcher": "scripts/process_watch.py",
    "maintenance": "app/log_maintenance.py",
    "quarantine": "logs/quarantaene/",
    "archive": "logs/archiv/",
    "rotation_max_bytes": 2097152,
    "rotation_max_age_days": 30,
    "rotation_keep": 5,
    "package_builder": "scripts/diagnosepaket.py",
    "package_rule": "Nur bereinigte Textkopien; abschließende Datenschutzprüfung vor ZIP-Übernahme"
  },
  "recovery_ui": {
    "window_module": "app/recovery_center.py",
    "dashboard_location": "single_navigation_item",
    "filters": ["severity", "area"],
    "detail_open": ["double_click", "button"],
    "repeat_fields": ["count", "first_seen"],
    "zoom_levels_percent": [100, 125, 150, 175, 200],
    "technical_details_default": "collapsed",
    "gui_test": "tests/test_recovery_ui_gui.py"
  },
  "recovery": {
    "iteration_restore": "scripts/iteration_restore.py",
    "backup_entrypoint": "scripts/backup_erstellen.sh",
    "status_rule": "OK nur nach ZIP-Prüfung, SHA-256, neuem Restore-Ordner, Manifestvergleich, Vollprüfung und Headless-Start"
  },
  "release_build": {
    "builder": "scripts/veroeffentlichen.py",
    "output_dir": "release",
    "rule": "Nur Dateien mit release=true"
  },
