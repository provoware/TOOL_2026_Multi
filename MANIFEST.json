{
  "schema_version": 7,
  "tool": {
    "name": "TOOL_2026_Multi",
    "repository": "provoware/TOOL_2026_Multi",
    "version": "0.8.0",
    "status": "AUSFUEHRBARER_KERN",
    "date": "2026-09-08"
  },
  "iteration": {
    "number": 8,
    "goal": "Songbibliothek, vorhandene Songs bearbeiten, letzte Songs, Metadaten, Versionsstände und Exporte in den bestehenden Songworkflow integrieren",
    "completed": 5,
    "open_next": 2
  },
  "runtime": {
    "entrypoint": "app/main.py",
    "launcher": "schnellstart.sh",
    "requirements": "requirements.txt",
    "headless_check": "python3 -m app.main --headless-check",
    "watcher": "scripts/process_watch.py",
    "diagnostic_package": "scripts/diagnosepaket.py"
  },
  "separation": {
    "source": "app/",
    "base_data": "daten/",
    "song_data": "daten/songtexte/",
    "song_versions": "daten/songtexte/.versionen/",
    "song_exports": "daten/songtexte/export/",
    "developer_quick_info": "Entwicklerinformation.txt",
    "texts": "texte/",
    "developer_docs": "docs/",
    "tests": "tests/",
    "runtime_logs": "logs/",
    "local_reports": "berichte/",
    "local_backups": "backups/"
  },
  "validation": {
    "command": "bash scripts/pruefen.sh --full",
    "runtime_command": "bash scripts/pruefen.sh --runtime",
    "headless_command": "python3 -m app.main --headless-check",
    "bounded": true,
    "targeted_tests": "python3 -m unittest tests.test_event_management tests.test_release_builder tests.test_security_watch tests.test_restore tests.test_diagnostics_logging tests.test_recovery_ui_logic tests.test_song_logic tests.test_song_library; xvfb-run -a python3 -m unittest tests.test_recovery_ui_gui tests.test_song_gui tests.test_song_library_gui",
    "write_failure_simulation": "python3 scripts/schreibfehler_simulieren.py"
  },
  "song_editor": {
    "storage": "daten/songtexte/<Titel>.txt",
    "working_format": "parsebare UTF-8-Textdatei",
    "backward_compatible_from": "0.7.0",
    "autosave_seconds": 300,
    "save_on_focus_out": true,
    "save_on_close": true,
    "fields": ["title", "genre_optional", "mood_optional", "style_optional", "voice_optional", "special_optional", "tags_optional", "sections", "other_optional"],
    "section_types": ["Intro", "Strophe", "Pre-Chorus", "Refrain", "Hook", "Bridge", "Outro", "Spoken", "Instrumental"],
    "preview": true,
    "atomic_write": true,
    "version_rule": "Vor einem geänderten Überschreiben wird der vorherige Stand als unveränderter Schnappschuss gesichert; identische Saves erzeugen keine Version.",
    "exports": ["txt", "markdown", "json", "lyrics_only_txt"]
  },
  "song_library": {
    "module": "app/song_library.py",
    "open_existing": true,
    "recent_dashboard_limit": 5,
    "sort": "modified_desc",
    "version_preview": "read_only",
    "working_files_glob": "daten/songtexte/*.txt"
  },
  "dashboard_quick_info": {
    "target": "Entwicklerinformation.txt",
    "mode": "append_only",
    "timestamp": true,
    "confirm": ["button", "enter"]
  },
  "diagnostics": {
    "machine_log": "logs/ereignisse.jsonl",
    "human_reports": "berichte/",
    "regression_state": "logs/rueckfaelle.json",
    "regression_registry": "tests/regression_registry.json",
    "dashboard_limit": 100,
    "redaction": "app/redaction.py",
    "watcher": "scripts/process_watch.py",
    "maintenance": "app/log_maintenance.py",
    "quarantine": "logs/quarantaene/",
    "archive": "logs/archiv/",
    "rotation_max_bytes": 2097152,
    "rotation_max_age_days": 30,
    "rotation_keep": 5,
    "package_builder": "scripts/diagnosepaket.py",
    "package_rule": "Nur bereinigte Textkopien; abschließende Datenschutzprüfung vor ZIP-Übernahme"
  },
  "recovery_ui": {
    "filters": ["severity", "area"],
    "detail_open": ["double_click", "enter", "button"],
    "repeat_fields": ["count", "first_seen"],
    "zoom_levels_percent": [100, 125, 150, 175, 200],
    "technical_details_default": "collapsed",
    "keyboard_shortcuts": ["Enter", "F5", "Ctrl++", "Ctrl+-", "Ctrl+0", "Escape"],
    "gui_test": "tests/test_recovery_ui_gui.py"
  },
  "recovery": {
    "iteration_restore": "scripts/iteration_restore.py",
    "backup_entrypoint": "scripts/backup_erstellen.sh",
    "status_rule": "OK nur nach ZIP-Prüfung, SHA-256, neuem Restore-Ordner, Manifestvergleich, Vollprüfung und Headless-Start"
  },
  "release_build": {
    "builder": "scripts/veroeffentlichen.py",
    "output_dir": "release",
    "rule": "Nur Dateien mit release=true"
  },
  "files": [
    {"path":"MANIFEST.json","release":true,"purpose":"Laufzeit- und Versionsdaten"},
    {"path":"ANLEITUNG_LAIEN.md","release":true,"purpose":"Nutzeranleitung"},
